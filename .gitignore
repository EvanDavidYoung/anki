# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.*
!.env.example

# OS cruft
.DS_Store

# Local data: chat logs, the message store, generated output.
# The .gitkeep files keep the directories themselves tracked.
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Web app local database + node/vite build artifacts
vocabapp.db
vocabapp.db-*
node_modules/
frontend/dist/

# TypeScript incremental build info
frontend/tsconfig.tsbuildinfo
