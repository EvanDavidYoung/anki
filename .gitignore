# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# OS cruft
.DS_Store

# Local data: chat logs, the message store, generated output.
# The .gitkeep files keep the directories themselves tracked.
input/*
!input/.gitkeep
output/*
!output/.gitkeep
