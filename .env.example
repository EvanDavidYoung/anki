# Copy this file to .env and fill in your own values. .env is gitignored.

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# --- Optional deck overrides ---
# These default to the values in config.toml; anything set here wins.
# DEFAULT_DECK=My Chinese Deck
# STAGING_DECK=Staging
# TARGET_DECK=My Chinese Deck
# CLOZE_DECK=My Chinese Deck
# HSK_DECK=My Chinese Deck::HSK
# study_decks is a list, so it must be JSON:
# STUDY_DECKS=["My Chinese Deck", "My Chinese Deck::HSK"]
